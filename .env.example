# PostgreSQL Database Settings
POSTGRES_DB=jobayer_portfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# Connection string (for local development outside Docker)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=jobayer_portfolio;Username=postgres;Password=postgrespassword

# JWT Security
JWT_SECRET=SuperSecretPortfolioKeyMinimum32BytesLongForSecurity!
JWT_ISSUER=PortfolioApi
JWT_AUDIENCE=PortfolioClients
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Bootstrap Super Admin (seeded automatically on first startup)
BOOTSTRAP_ADMIN_EMAIL=admin@jobayer.dev
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# CORS Allowed Origins
CORS_PUBLIC_ORIGINS=http://localhost:4200
CORS_ADMIN_ORIGINS=http://localhost:4300

# File Upload Storage
STORAGE_LOCAL_ROOT_PATH=./wwwroot/uploads


