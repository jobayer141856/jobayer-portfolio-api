{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PortfolioDb": "Host=localhost;Port=5432;Database=jobayer_portfolio;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "jobayer-portfolio-api",
    "Audience": "jobayer-portfolio-admin",
    "SigningKey": "a-super-secret-jwt-key-with-minimum-32-characters-for-sha256",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14
  },
  "Cors": {
    "PublicOrigins": [
      "https://jobayer-portfolio-web.vercel.app",
      "http://localhost:4200"
    ],
    "AdminOrigins": [
      "https://jobayer-portfolio-admin.jobayerhossen64.workers.dev",
      "http://localhost:4300"
    ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads",
    "MaxImageSizeBytes": 5242880,
    "MaxDocumentSizeBytes": 10485760
  },
  "Email": {
    "Enabled": false,
    "Provider": "Smtp",
    "FromAddress": "noreply@jobayer.dev",
    "AdminNotificationAddress": "admin@jobayer.dev"
  },
  "BootstrapAdmin": {
    "Email": "admin@jobayer.dev",
    "InitialPassword": "Admin@123456Password"
  }
}
